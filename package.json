{
  "name": "shadow-king",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "build:test": "tsc -b && vite build --mode test --outDir dist-test",
    "test:browser": "node tests/browser.cjs",
    "test:production": "node tests/production.cjs",
    "test:restart": "node tests/production.cjs --restart",
    "test:lifecycle": "node tests/lifecycle.cjs",
    "test:ai:browser": "tsx tests/ai-browser.ts",
    "test:ai:controller": "node tests/ai-controller.cjs",
    "test:ai:tournament": "tsx tests/tournament.ts",
    "test:production:ai": "node tests/production-ai.cjs",
    "test:balance": "tsx scripts/balance.ts",
    "report:balance": "tsx scripts/report-balance.ts",
    "test:ritual:browser": "node tests/ritual-browser.cjs",
    "test:ritual:full": "tsx tests/ritual-full-game.ts",
    "test:ritual:production": "node tests/ritual-production.cjs",
    "test:v04": "node tests/v04-browser.cjs",
    "test:v04:frames": "node tests/v04-frames.cjs",
    "test:ai:v05": "tsx --test tests/ai-v05.test.ts",
    "test:ai:arena": "tsx scripts/ai-v05-arena.ts",
    "test:omniscient": "tsx --test tests/omniscient.test.ts",
    "test:v06:browser": "node tests/v06-browser.cjs",
    "test:v06:arena": "node scripts/v06-arena.cjs",
    "test:combat": "tsx --test tests/combat.test.ts tests/battle-timeline.test.ts",
    "test:combat:browser": "node tests/combat-browser.cjs",
    "test:combat:production": "node tests/combat-production.cjs && node tests/combat-production.cjs --ritual",
    "record:combat": "node scripts/v07-reel.cjs",
    "test:combat:background": "node tests/combat-background.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.65.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
